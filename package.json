{
  "name": "Sanitiz3r",
  "productName": "Sanitiz3r",
  "version": "1.0.0",
  "description": "Configurable input & file entry-point sanitizer with project scanner. Blocks XSS, SQLi, SSTI, and command-injection payloads at every text and upload field.",
  "author": "Blu Corbel",
  "license": "MIT",
  "main": "main.js",
  "homepage": "https://github.com/HevvyDevvy/Sanitizer",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:appx": "electron-builder --win appx",
    "dist:nsis": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.tmhp.Sanitiz3r",
    "productName": "Sanitiz3r",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "bundle-template/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "win": {
      "target": [
        { "target": "appx", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico",
      "sign": "./build-resources/customSign.cjs",
      "signingHashAlgorithms": ["sha256"]
    },
    "appx": {
      "applicationId": "Sanitiz3r",
      "identityName": "TMHP.com.Sanitiz3r",
      "publisherDisplayName": "@TMHP.com",
      "backgroundColor": "#0a0d12",
      "showNameOnTiles": true,
      "languages": ["en-US"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
